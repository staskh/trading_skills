# Copy to .env and fill in values. The .env file is loaded automatically
# (via python-dotenv) by tests and by the ib-* skill scripts.

# Interactive Brokers connection port. Default when --port is not passed on an
# ib-* skill. Precedence: --port flag > IB_PORT > built-in default (7497 paper).
# Use 4001/4002 for the IB Gateway container (live/paper), 7496/7497 for TWS.
IB_PORT=

# IBKR Flex Web Service. Enables full trade history in ib-trades-history —
# reqExecutionsAsync only returns the CURRENT SESSION, so any lookback beyond
# today (or any query on a weekend) needs these. Precedence: --flex-token /
# --flex-query-id flags > these env vars. IB_FLEX_QUERY_ID accepts a
# comma-separated list to merge queries spanning different periods.
# Tokens expire — regenerate under Performance & Reports > Flex Queries.
IB_FLEX_TOKEN=
IB_FLEX_QUERY_ID=

# Massive API key — enables the whale-hunting integration tests and skills.
MASSIVE_API_KEY=

# Financial Modeling Prep API key.
FMP_API_KEY=

# Langfuse tracing (optional).
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
